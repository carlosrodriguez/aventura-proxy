generator client {
 provider = "prisma-client"
 output = "../generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum AssociationRole {
 ADMIN
 APPROVER
 OBSERVER
}
enum EventState {
 DRAFT
 APPROVED
 OPEN
 CLOSED
 CANCELLED
 CERTIFIED
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 displayName String
 createdAt DateTime @default(now())
 memberships AssociationMembership[]
 managementMemberships ManagementMembership[]
 entitlements VotingEntitlement[]
}
model Association {
 id String @id @default(uuid()) @db.Uuid
 name String
 stateCode String
 associationType String
 memberships AssociationMembership[]
 managementGrants ManagementGrant[]
 properties Property[]
 events VotingEvent[]
}
model ManagementCompany {
 id String @id @default(uuid()) @db.Uuid
 name String
 memberships ManagementMembership[]
 associations ManagementGrant[]
}
model ManagementMembership {
 userId String @db.Uuid
 companyId String @db.Uuid
 user User @relation(fields:[userId],references:[id])
 company ManagementCompany @relation(fields:[companyId],references:[id])
 active Boolean @default(false)
 @@id([userId,companyId])
}
model ManagementGrant {
 associationId String @db.Uuid
 companyId String @db.Uuid
 association Association @relation(fields:[associationId],references:[id])
 company ManagementCompany @relation(fields:[companyId],references:[id])
 active Boolean @default(false)
 @@id([associationId,companyId])
}
model AssociationMembership {
 userId String @db.Uuid
 associationId String @db.Uuid
 user User @relation(fields:[userId],references:[id])
 association Association @relation(fields:[associationId],references:[id])
 role AssociationRole
 active Boolean @default(false)
 @@id([userId,associationId])
}
model Property {
 id String @id @default(uuid()) @db.Uuid
 associationId String @db.Uuid
 association Association @relation(fields:[associationId],references:[id])
 reference String
 address String
 entitlements VotingEntitlement[]
 @@unique([id,associationId])
 @@unique([associationId,reference])
}
// Approval belongs to the HOA, not to an email verification or account login.
model VotingEntitlement {
 id String @id @default(uuid()) @db.Uuid
 associationId String @db.Uuid
 propertyId String @db.Uuid
 userId String @db.Uuid
 property Property @relation(fields:[propertyId,associationId],references:[id,associationId])
 user User @relation(fields:[userId],references:[id])
 votingWeight Decimal @db.Decimal(12,4)
 approvedAt DateTime?
 approvedBy String? @db.Uuid
 endsAt DateTime?
 @@index([associationId,userId])
}
// These are proposed event records, not operational ballot storage.
model VotingEvent {
 id String @id @default(uuid()) @db.Uuid
 associationId String @db.Uuid
 association Association @relation(fields:[associationId],references:[id])
 title String
 state EventState @default(DRAFT)
 revision Int @default(1)
 createdBy String @db.Uuid
 approvedBy String? @db.Uuid
 approvedRevision Int?
 procedureReviewed Boolean @default(false)
 opensAt DateTime?
 closesAt DateTime?
 ruleSnapshot Json?
 createdAt DateTime @default(now())
 @@index([associationId,state])
}

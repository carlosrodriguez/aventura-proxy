# Disabled until the exact official template has been inserted and reviewed.
ENABLE_SUBMISSIONS=false
ENABLE_ADMIN=false
# Planned production origin: https://vote.aventuraislesproxy.com
# Use localhost for local development; set APP_URL to the production origin on deployment.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aventura
OTP_PEPPER=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SPACES_ENDPOINT=
SPACES_REGION=us-east-1
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# Full name of an attending proxyholder. TBD keeps finalization disabled.
PROXYHOLDER_NAME=TBD
PROXY_DELIVERY_EMAIL=manager@aventuraisleshoa.com
ADMIN_EMAIL=
CONTACT_EMAIL=manager@aventuraisleshoa.com
RETENTION_DAYS=90
# Set only to a header your reverse proxy overwrites, never a client-supplied header.
TRUSTED_IP_HEADER=
APP_VERSION=1.0.0
GIT_COMMIT_SHA=
